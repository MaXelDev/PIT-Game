#!/usr/bin/env bash
# shellcheck disable=SC2016 # Les tests composés passent à eval des variables à évaluer plus tard.
# Vérificateurs : comparaison avec les références de l'état.
source "$PIT_SOURCE/src/lib.sh"
pit_init_variables
ok_total=1
point() {
    local titre=$1; shift
    if "$@" >/dev/null 2>&1; then printf '\033[32m✔\033[0m %s\n' "$titre"; else printf '\033[31m✘\033[0m %s\n' "$titre"; ok_total=0; fi
}
meme() { [[ -f $1 && -f $2 ]] && cmp -s -- "$1" "$2"; }
absent() { [[ ! -e $1 && ! -L $1 ]]; }
d() { printf '%s/niveau_%s' "$PIT_RACINE" "${PIT_ROMAINS[$1-1]}"; }
ref() { printf '%s/ref/%s' "$PIT_ETAT" "$1"; }
fin() { if ((ok_total)); then pit_valider "$1"; else printf 'Niveau incomplet : corrigez les points marqués ✘.\n'; return 1; fi; }

verif_1() {
    local saisie
    read -r -p 'Fragment du niveau I : ' saisie
    point 'Fragment correct' test "$saisie" = "${PIT_CODE:0:1}"
    fin 1
}
verif_2() {
    local x; x=$(d 2)
    point 'Dossier archive créé' test -d "$x/archive"
    point 'Dossier tri créé' test -d "$x/tri"
    point 'Copie dans archive/rapport.txt' meme "$x/archive/rapport.txt" "$(ref 2)/rapport.txt"
    point 'Original renommé dans tri/rapport_old.txt' meme "$x/tri/rapport_old.txt" "$(ref 2)/rapport.txt"
    point "Aucun rapport.txt ni rapport_old.txt à la racine du niveau" eval 'absent "$x/rapport.txt" && absent "$x/rapport_old.txt"'
    point 'Dossier poubelle supprimé' absent "$x/poubelle"
    point 'Seule la ligne INVALIDE a été supprimée' meme "$x/config.txt" "$(ref 2)/config.attendu"
    fin 2
}
verif_3() {
    local x; x=$(d 3)
    point 'reponse.txt existe' test -f "$x/reponse.txt"
    point 'Lignes ALERTE exactes, puis CAPTEUR=NN' meme "$x/reponse.txt" "$(ref 3)/attendu"
    fin 3
}
verif_4() {
    local x c nom; x=$(d 4); IFS= read -r c < "$(ref 4)/chemin"; nom=${c##*/}
    point 'Fichier cible présent dans labo/' test -f "$x/labo/$nom"
    point "Contenu modifié exactement comme demandé" meme "$x/labo/$nom" "$(ref 4)/attendu"
    point "Fichier retiré de l'arborescence (mv, pas cp)" absent "$x/$c"
    if fin 4; then printf 'Fragment 4 : %s\n' "${PIT_CODE:3:1}" > "$x/code_niveau4.txt"; printf 'code_niveau4.txt créé.\n'; fi
}
verif_5() {
    local n
    for n in A B C; do point "Brouilleur $n neutralisé" eval "! pit_actif brouilleur_$n"; done
    point 'Emetteur actif' pit_actif emetteur
    ((ok_total)) && printf 'Lisez maintenant signal.txt.\n'
}
droits_ok() { [[ $(stat -c %a "$1") == "$(<"$(ref 6)/droits")" ]]; }
verif_coffre() {
    local f; f=$(d 6)/coffre.sh
    point 'Vous êtes propriétaire de coffre.sh' test "$(stat -c %u "$f")" = "$(id -u)"
    point 'Droits conformes à la règle' droits_ok "$f"
    point 'Variable CLE exportée' test -n "${CLE+x}"
    point 'Valeur de CLE correcte' test "${CLE-}" = "$(<"$PIT_ETAT/agent")"
    ((ok_total)) || printf 'Droits actuels : %s. CLE doit être visible par le script (export).\n' "$(stat -c %A "$f")"
    fin 6
}
verif_7() {
    local x t m; x=$(d 7); t=$(mktemp -d "$PIT_ETAT/verif.XXXXXX")
    point 'Extraction présente dans extraction/mission' test -d "$x/extraction/mission"
    point 'retour.tar.gz lisible' tar -xzf "$x/retour.tar.gz" -C "$t"
    m=$t/mission; [[ -d $m ]] || m=$t/extraction/mission
    point 'Archive contenant le dossier mission' test -d "$m"
    point 'ACTIF=oui seulement dans ouverture.conf' diff -r "$m" "$(ref 7)/attendu/mission"
    pit_effacer "$t"; fin 7
}
verif_final() {
    local saisie reste debut
    saisie=$(tr -d ' \t\r\n' < "$PIT_RACINE/code.txt" 2>/dev/null)
    if [[ -z $saisie || $saisie == ________ ]]; then printf 'Écrivez les 8 fragments dans code.txt, puis relancez bash verifier.\n'; return 0; fi
    if [[ ! $saisie =~ ^[A-Za-z0-9]{8}$ ]]; then printf 'Format invalide : 8 caractères alphanumériques attendus.\n'; return 1; fi
    printf '%s\n' "$saisie" >> "$PIT_ETAT/tentatives"
    if [[ $saisie != "$PIT_CODE" ]]; then
        pit_penalite 300 'mauvais code'
        printf '\033[31mCODE FAUX : pénalité de 5 minutes.\033[0m\n'; return 1
    fi
    reste=$(pit_minuteur) || reste=0; IFS= read -r debut < "$PIT_ETAT/debut"
    mkdir "$PIT_ETAT/termine" 2>/dev/null || return 1
    printf 'victoire\n' > "$PIT_ETAT/issue"
    printf '\033[32mBOMBE DÉSAMORCÉE.\033[0m Temps restant : %s. Temps écoulé : %s.\n' "$(pit_temps "$reste")" "$(pit_temps "$(( $(date +%s) - debut ))")"
}
case ${1-} in
    [1-8]|coffre|final) declare -F "verif_$1" >/dev/null || { printf 'Vérificateur indisponible.\n'; exit 1; }; "verif_$1";;
    *) printf 'Usage : pit_verif 1…8\n'; exit 1;;
esac
